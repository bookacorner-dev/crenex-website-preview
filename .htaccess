# ============================================================
# crenex.io — sitio estático multi-página (Hostinger / Apache)
# NO incluye rewrite tipo SPA a propósito: cada página es su
# propio .html. Un rewrite global rompería las páginas internas.
# ============================================================

# --- Rutas de la versión anterior -> páginas actuales ---
# Destinos HTTPS canónicos y query strings conservadas, sin cadenas de saltos.
RewriteEngine On
RewriteRule ^solutions/crm/?$ https://crenex.io/workflow.html [R=301,L]
RewriteRule ^solutions/listing/?$ https://crenex.io/listing.html [R=301,L]
RewriteRule ^solutions/ai-agent/?$ https://crenex.io/ai-agent.html [R=301,L]
RewriteRule ^industries/(retail|residential|offices|advertising)/?$ https://crenex.io/industries.html [R=301,L]
RewriteRule ^partnerships/mri/?$ https://crenex.io/mri-integration.html [R=301,L]

# Alias sin extensión, incluido /blog/ (directorio físico sin index).
RewriteRule ^(platform|workflow|listing|ai-agent|industries|customers|roi-calculator|mri-integration|blog|trust|demo|privacy-policy|terms-and-conditions)/?$ https://crenex.io/$1.html [R=301,L]

# Solo artículos existentes: los slugs desconocidos siguen devolviendo 404.
RewriteRule ^blog/(specialty-leasing-in-the-u-s-2026|casual-mall-leasing-in-australia-2026|crenex-and-mri-software-official-partners-in-short-term-leasing-management|trends-in-the-short-term-leasing-market-key-insights-for-2026|complete-guide-to-optimizing-lease-management-in-shopping-centers|checklist-is-your-shopping-mall-ready-for-digital-transformation)/?$ https://crenex.io/blog/$1.html [R=301,L]

# THE_REQUEST evita redirigir la resolución interna de / a index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://crenex.io/ [R=301,L]

# --- Origen canónico: HTTPS y sin www ---
RewriteCond %{HTTP_HOST} ^www\.crenex\.io$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://crenex.io%{REQUEST_URI} [L,R=301]

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # CSP: el sitio usa estilos inline -> 'unsafe-inline' acotado a style-src.
  # Google Analytics se carga solo tras consentimiento; sin inline/eval ni endpoints publicitarios.
  # form-action conserva el POST nativo de FormSubmit con CAPTCHA.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'"
</IfModule>

# --- Cache de assets estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML sin cache agresiva para no servir contenido viejo
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Error real con navegación independiente de la URL solicitada ---
ErrorDocument 404 /404.html
